# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Databases & SQLite
*.db
*.sqlite
*.sqlite3
fraud_detection.db

# Large Data & Training Artifacts (generated via run.py)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# ML Model Binary Artifacts
ml/artifacts/*.joblib
ml/artifacts/*.pkl

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor specific files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db

# Others
*.docx
